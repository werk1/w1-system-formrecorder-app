{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@/w1-system": ["./src/w1-system/index.ts"],
      "@/w1-system/*": ["./src/w1-system/*"],
      "@werk1/w1-system-timeline-engine": ["../w1-system-timeline-engine/src/index.ts"],
      "@werk1/w1-system-timeline-engine/*": ["../w1-system-timeline-engine/src/*"],
      "@werk1/w1-system-imageblock": ["../w1-system-imageblock/src/index.ts"],
      "@werk1/w1-system-imageblock/*": ["../w1-system-imageblock/src/*"],
      "@werk1/w1-system-media-manager": ["../w1-system-media-manager/src/index.ts"],
      "@werk1/w1-system-media-manager/*": ["../w1-system-media-manager/src/*"],
      "@werk1/w1-system-carouselblock": ["../w1-system-carouselblock/src/index.ts"],
      "@werk1/w1-system-carouselblock/*": ["../w1-system-carouselblock/src/*"],
      "@werk1/w1-system-pdfedit": ["../w1-system-pdfedit/src/index.ts"],
      "@werk1/w1-system-pdfedit/*": ["../w1-system-pdfedit/src/*"],
      "@werk1/w1-system-flipbook": ["../w1-system-flipbook/src/index.ts"],
      "@werk1/w1-system-flipbook/*": ["../w1-system-flipbook/src/*"],
      "@werk1/w1-system-ui": ["../w1-system-ui/src/index.ts"],
      "@werk1/w1-system-ui/*": ["../w1-system-ui/src/*"],
      "@werk1/w1-system-widgets": ["../w1-system-widgets/src/index.ts"],
      "@werk1/w1-system-widgets/*": ["../w1-system-widgets/src/*"],
      "@werk1/w1-system-calendar": ["../w1-system-calendar/src/index.ts"],
      "@werk1/w1-system-calendar/*": ["../w1-system-calendar/src/*"],
      "next": ["./node_modules/next"],
      "next/*": ["./node_modules/next/*"],
      "payload": ["./node_modules/payload"],
      "payload/*": ["./node_modules/payload/dist/*"],
      "@payload-config": ["./src/payload.config.ts"]
    },
    "target": "ES2022",
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
