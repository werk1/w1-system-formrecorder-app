FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=development

# Install Infisical CLI for production secret loading.
# The entrypoint in docker-compose.yml wraps the migrator with `infisical run`.
RUN npm install -g @infisical/cli

# Copy the full project (src, scripts, node_modules, package.json, tsconfig, etc.)
# The build context is the main project directory with linked @werk1 packages
# and devDependencies already installed by multi_repo_build.sh.
COPY . .

# Re-install platform-specific optional deps for alpine (sharp, etc.).
# Shared with Dockerfile_Multi so the platform filter logic only lives in
# one place (see reinstall-optional-deps.sh).
COPY reinstall-optional-deps.sh /tmp/reinstall-optional-deps.sh
RUN sh /tmp/reinstall-optional-deps.sh && rm -f /tmp/reinstall-optional-deps.sh

CMD ["echo", "Migrator image. Use: docker compose --profile migrate run --rm migrator npm run <migration-script>"]
